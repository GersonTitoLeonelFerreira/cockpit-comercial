# ==============================================================================
# Yolen / Cockpit Comercial - Variáveis de ambiente
# ==============================================================================
# Este arquivo é apenas um modelo.
# Nunca coloque chaves reais neste arquivo.
# Configure os valores reais em .env.local no ambiente local e nas Environment
# Variables da Vercel em produção/homologação.

# ==============================================================================
# Supabase público - usado no client e server components
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-publica"

# ==============================================================================
# Supabase server-side - nunca expor no navegador
# Usado por rotas API administrativas e operações server-side.
# ==============================================================================
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role"

# ==============================================================================
# URL pública da aplicação
# Em produção, use o domínio real do sistema.
# Exemplo: https://app.yolen.com.br
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# A Vercel injeta VERCEL_URL automaticamente em deploys.
# Só preencha manualmente se realmente precisar sobrescrever.
VERCEL_URL=""

# ==============================================================================
# E-mail / Resend
# ==============================================================================
RESEND_API_KEY="sua-chave-resend"

# Remetente usado em convites administrativos.
# Exemplo: Yolen <convites@seudominio.com.br>
ADMIN_INVITE_FROM_EMAIL="Cockpit Comercial <onboarding@resend.dev>"

# Remetente fallback para integrações de e-mail.
RESEND_FROM_EMAIL="Cockpit Comercial <onboarding@resend.dev>"

# E-mail que recebe pedidos públicos de demonstração.
DEMO_NOTIFY_EMAIL="seu-email@seudominio.com.br"
