{
  "manifest_version": 3,
  "name": "Yolen Companion",
  "version": "0.1.6",
  "description": "Camada de leitura assistida da Yolen para WhatsApp Web.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://cockpit-comercial-vocn.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "scripts": [
      "src/capture-transport.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "src/yolen-api.js",
        "src/message-mutations.js",
        "src/capture-batch.js",
        "src/capture-resilience.js",
        "src/content-script.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cockpit-comercial-vocn.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": ["src/yolen-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/yolen-page-bridge.js"],
      "matches": [
        "https://cockpit-comercial-vocn.vercel.app/*",
        "http://localhost:3000/*"
      ]
    },
    {
      "resources": ["src/whatsapp-audio-bridge.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "yolen-companion@gerson.local"
    }
  }
}
